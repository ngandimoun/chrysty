# App (production: https://chrysty.chrysty.dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WORKER_SLUG=chrysty

# Chrysty platform API
NEXT_PUBLIC_CHRYSTY_API_URL=https://api.chrysty.dev
CHRYSTY_API_URL=https://api.chrysty.dev
# Shared auth: production cookies use domain .chrysty.dev
# Supabase Auth redirect: https://chrysty.chrysty.dev/auth/callback

# Supabase (shared chrysty.dev project)
NEXT_PUBLIC_SUPABASE_URL=https://uusnstujtczqjorfqgdn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPLOADS_BUCKET=astra-uploads
DATABASE_URL=

# Gemini (server-side only — never use NEXT_PUBLIC_*)
GEMINI_API_KEY=
GEMINI_STT_MODEL=gemini-3.1-flash-lite
GEMINI_RESPONSE_MODEL=gemini-3.1-flash-lite
# Optional comma-separated fallbacks when the primary response model fails or times out
# GEMINI_TEACHER_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.1-pro-preview
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Aoede
GEMINI_ENABLE_GOOGLE_SEARCH=true
GEMINI_ENABLE_GOOGLE_MAPS=true
GEMINI_ENABLE_URL_CONTEXT=true
GEMINI_ENABLE_CUSTOM_TOOLS=true
GEMINI_ENABLE_CODE_EXECUTION=true
# When true (default if COMPOSIO_API_KEY is set), attach Composio tools for users with connected toolkits
GEMINI_ENABLE_COMPOSIO_TOOLS=true

# Composio (server-side only — never use NEXT_PUBLIC_*)
# Toolkit OAuth + Tool Router sessions for Settings → Connection
COMPOSIO_API_KEY=

# Pexels (server-side only — used for optional explanation canvas reference photos)
PEXELS_API_KEY=

# Optional — enables getWeather custom tool when set
OPENWEATHER_API_KEY=

# Background jobs — Kimi (Moonshot) powered Mastra agents (server-side only)
# All three are required to enable voice-delegated background work.
MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# KIMI_AGENT_MODEL=kimi-k2.6
# Shared secret protecting the internal self-chaining runner route (any long random string)
GENERATION_INTERNAL_SECRET=
# Optional overrides
# ASTRA_JOB_LEG_BUDGET_MS=230000
# APP_URL=https://your-production-domain.com

# Mem0 companion memory (server-side only)
MEM0_API_KEY=

# Gemini Live (Cloud Run WebSocket service)
NEXT_PUBLIC_GEMINI_LIVE_ENABLED=false
NEXT_PUBLIC_LIVE_WS_URL=
# Shared secret for Cloud Run → Astra /api/live/* (any long random string)
LIVE_SERVICE_INTERNAL_SECRET=
# Optional: in-app live journey debug panel
NEXT_PUBLIC_DEBUG_LIVE_JOURNEY=false
MEM0_AGENT_ID=chrysty-astra
MEM0_SEARCH_TOP_K=8
MEM0_SEARCH_THRESHOLD=0.3
# Optional: dev fallback to restore personal workspace when stuck on benchmark key
# NEXT_PUBLIC_ASTRA_PERSONAL_KEY=ak_your_personal_key_here

# Browser perception (lazy-loaded after camera use)
NEXT_PUBLIC_PERCEPTION_ENABLED=true
NEXT_PUBLIC_DEBUG_PERCEPTION=false
NEXT_PUBLIC_PERCEPTION_MODEL_BASE_URL=

# TTS uses buffered full-utterance playback (complete audio before play) for smooth speech.

# Local HTTPS dev (iPad / LAN testing) — optional
DEV_HOST=192.168.1.69
