{
  "name": "chrysty",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "npm run build --prefix packages/platform",
    "dev": "next dev --turbopack",
    "dev:https": "node scripts/print-dev-urls.mjs && next dev --turbopack --experimental-https -H 0.0.0.0 --experimental-https-key ./certificates/dev-key.pem --experimental-https-cert ./certificates/dev-cert.pem",
    "dev:ipad": "pnpm dev:https",
    "certs:install": "node scripts/setup-dev-certs.mjs",
    "auth:redirects": "node scripts/configure-auth-redirects.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:perception": "node scripts/run-perception-browser-tests.mjs",
    "test:perception:headed": "node scripts/run-perception-browser-tests.mjs --headed",
    "playwright:install": "playwright install chromium",
    "test:tools": "tsx scripts/run-tool-matrix.mjs",
    "test:background-jobs": "tsx scripts/run-background-job-matrix.mjs",
    "test:background-jobs:validate": "tsx scripts/validate-background-job-report.mjs",
    "test:delegation": "tsx scripts/run-delegation-matrix.mjs",
    "test:ecosystem": "tsx scripts/test-ecosystem-activity.ts",
    "test:mem0": "tsx scripts/test-mem0-memory.ts",
    "test:gemini-errors": "tsx tests/gemini/user-facing-error.test.ts",
    "test:zoom-model": "tsx tests/camera/zoom-model.test.ts",
    "db:apply": "node scripts/apply-astra-migrations.mjs",
    "db:verify": "node scripts/verify-astra-schema.mjs"
  },
  "dependencies": {
    "@chrysty/platform": "file:packages/platform",
    "@base-ui/react": "^1.6.0",
    "@google/genai": "^2.3.0",
    "@livekit/components-react": "^2.9.21",
    "@mastra/core": "^1.49.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@zxing/browser": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "katex": "^0.17.0",
    "livekit-client": "^2.20.0",
    "lucide-react": "^1.23.0",
    "mem0ai": "^3.0.13",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "onnxruntime-web": "^1.27.0",
    "openai": "^6.45.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.1",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@serwist/next": "^9.5.11",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "serwist": "^9.5.11",
    "shadcn": "^4.12.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
